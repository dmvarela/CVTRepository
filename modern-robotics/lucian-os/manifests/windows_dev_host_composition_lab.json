      "provides": [
        "manifest.read",
        "capability.enumerate"
      ],
      "risk_level": "low",
      "reversible": true,
      "requires_confirmation": false,
      "verification": "manifest data returned",
      "enabled": true
    },
    {
      "name": "reason_about_task",
      "kind": "compute",
      "provides": [
        "reason.task",
        "plan.propose"
      ],
      "risk_level": "low",
      "reversible": true,
      "requires_confirmation": false,
      "verification": "structured proposal returned",
      "enabled": true
    },
    {
      "name": "read_file",
      "kind": "observe",
      "provides": [
        "filesystem.read"
      ],
      "risk_level": "low",
      "reversible": true,
      "requires_confirmation": false,
      "verification": "requested content can be compared with source",
      "enabled": false,
      "note": "declared for composition planning only; no real adapter enabled"
    },
    {
      "name": "write_file",
      "kind": "act",
      "provides": [
        "filesystem.write"
      ],
      "risk_level": "medium",
      "reversible": "sometimes",
      "requires_confirmation": true,
      "verification": "read-after-write and diff",
      "enabled": false
    },
    {
      "name": "delete_file",
      "kind": "act",
      "provides": [
        "filesystem.delete"
      ],
      "risk_level": "high",
      "reversible": false,
      "requires_confirmation": true,
      "verification": "path absence plus audit record",
      "enabled": false
    },
    {
      "name": "network_uplink",
      "kind": "communicate",
      "provides": [
        "network.request",
        "reason.escalate"
      ],
      "risk_level": "medium",
      "reversible": true,
      "requires_confirmation": false,
      "verification": "response receipt",
      "enabled": false,
      "note": "declared for composition planning only; no network action is enabled"
    }
  ],
  "authority_defaults": {
    "mode": "simulation_only",
    "permitted": [
      "inspect_manifest",
      "reason_about_task"
    ],
    "prohibited": [
      "write_file",
      "delete_file",
      "external_commitment",
      "physical_actuation"
    ]
  },
  "verification_methods": [
    "structured_output_validation",
    "manifest_cross_check",
