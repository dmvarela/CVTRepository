{
  "protocol_version": "0.1",
  "composition_lab_version": "0.01",
  "embodiment_id": "windows-dev-001",
  "identity": {
    "type": "windows_computer",
    "role": "development embodiment",
    "simulation_only": true
  },
  "local_compute": {
    "python": true,
    "ollama": true
  },
  "available_models": [],
  "capabilities": [
    {
      "name": "inspect_manifest",
